# Frontend Environment Variables - Example
# Copy this file to .env.local for development
# For Vercel deployment, set these in Vercel Environment Variables

# API URL for REST endpoints
# Development: http://localhost:5000 (with Vite proxy)
# Production: https://live-chat-app-production-69b9.up.railway.app
VITE_API_URL=https://live-chat-app-production-69b9.up.railway.app

# Server URL for Socket.IO connections
# Development: http://localhost:5000
# Production: https://live-chat-app-production-69b9.up.railway.app
VITE_SERVER_URL=https://live-chat-app-production-69b9.up.railway.app
